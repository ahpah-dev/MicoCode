{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "components/micocode/**/*.tsx",
    "lib/mico/**/*.ts",
    "api/**/*.ts",
    "app/api/**/*.ts",
    "website/**/*.tsx",
    "vite.config.browser.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-web"
  ]
}
