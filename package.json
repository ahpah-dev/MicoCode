{
  "name": "micocode",
  "version": "0.8.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.browser.ts",
    "build": "vite build --config vite.config.browser.ts",
    "build:web": "vite build --config vite.config.browser.ts",
    "preview": "vite preview --config vite.config.browser.ts",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "package:kit": "node scripts/package-kit.mjs",
    "build:desktop": "npm run build:web && node scripts/prepare-desktop.mjs",
    "package:windows": "npm run build:desktop && electron-builder --config electron-builder.yml --win --publish never",
    "release:publish": "node scripts/publish-release.mjs",
    "desktop": "electron build/desktop-app"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/view": "^6.38.0",
    "@mlc-ai/web-llm": "^0.2.85",
    "@uiw/react-codemirror": "^4.25.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "yauzl": "3.4.0"
  },
  "type": "module",
  "description": "A local-first agentic coding workspace. Little ideas. Real things.",
  "license": "MIT"
}
